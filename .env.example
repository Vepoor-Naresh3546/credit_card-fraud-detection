FRAUD_API_KEY=replace-with-long-random-local-key
FRAUD_THRESHOLD=
GRAFANA_ADMIN_PASSWORD=replace-before-local-use
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=replace-before-local-use
AIRFLOW_ADMIN_EMAIL=admin@example.invalid
AIRFLOW_DB_PASSWORD=replace-before-local-use
AIRFLOW_SECRET_KEY=replace-with-random-airflow-webserver-key
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_RAW_TOPIC=transactions.raw
KAFKA_SCORED_TOPIC=transactions.scored
KAFKA_ALERTS_TOPIC=fraud.alerts
KAFKA_DLQ_TOPIC=transactions.dlq
KAFKA_CONSUMER_GROUP=fraud-scoring-v1
MIN_MODEL_F1=0.65
MIN_MODEL_RECALL=0.70
