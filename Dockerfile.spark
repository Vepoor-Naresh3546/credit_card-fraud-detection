FROM apache/spark:4.0.0

USER root
RUN python3 -m pip install --no-cache-dir pandas==2.2.3 scikit-learn==1.6.1 joblib==1.4.2
WORKDIR /opt/fraud-platform
ENV PYTHONPATH=/opt/fraud-platform \
    MODEL_PATH=/opt/fraud-platform/models/creditcard_model.joblib \
    MODEL_METADATA_PATH=/opt/fraud-platform/models/creditcard_model_metadata.json
COPY fraud_platform ./fraud_platform
COPY models/creditcard_model.joblib models/creditcard_model_metadata.json ./models/
CMD ["python3", "-m", "fraud_platform.spark_jobs", "--help"]
