{
  "id": null,
  "uid": "fraud-platform",
  "title": "Credit Card Fraud Platform",
  "tags": ["fraud", "mlops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API requests / second by endpoint",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (endpoint) (rate(creditcard_api_requests_total[5m]))", "legendFormat": "{{endpoint}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API p95 latency",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(creditcard_api_request_duration_seconds_bucket[5m])))", "legendFormat": "{{endpoint}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API 5xx responses / second",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (endpoint) (rate(creditcard_api_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "{{endpoint}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Fraud decisions / second",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (decision) (rate(creditcard_prediction_total[5m]))", "legendFormat": "{{decision}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka worker outcomes / second",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (outcome) (rate(creditcard_worker_events_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scrape target availability",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
      "targets": [{"expr": "up", "legendFormat": "{{job}} / {{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bool"}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Recent feature PSI",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
      "targets": [{"expr": "creditcard_feature_drift_psi", "legendFormat": "{{feature}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ]
}
